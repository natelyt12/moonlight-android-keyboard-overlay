<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121316">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/top_bar_container"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1A1C22"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/vk_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:singleLine="true"
            android:text="@string/vk_layouts_title"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Import Button -->
        <Button
            android:id="@+id/btn_top_import"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#262A33"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/vk_import"
            android:textAllCaps="false"
            android:textColor="#00B4D8"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <!-- New Layout Button -->
        <Button
            android:id="@+id/btn_top_new_layout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#0077B6"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/vk_new"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#20FFFFFF" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/txt_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/vk_no_layouts"
        android:textColor="#757575"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- List View with Gaps between Cards -->
    <ListView
        android:id="@+id/list_keyboard_layouts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp"
        android:padding="12dp"
        android:clipToPadding="false" />

</LinearLayout>
